{% extends 'templates/base.jinja2' %}

{% block headers %}

    {% set title = 'Pricing - Text Generator AI API Plans and Credits' -%}
    {% set description = 'Text Generator pricing: a cloud plan from $19/month, pay-as-you-go API credits at $0.01, or self-host the open source stack for free.' -%}

    <meta charset="utf-8">
    <title>{{ title }}</title>
    <meta name="description"
          content="{{ description }}">

    <meta name="keywords" content="text generator, Open AI, subscribe">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:url" content="{{ url }}">
    <meta property="og:image" content="https://text-generator.io/static/img/og-card.jpg">
    <meta property="og:description"
          content="{{ description }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Text Generator">
    <meta property="fb:admins" content="337972272904903">

{% endblock %}

{% block mainbody %}
    <h1 class="tg-page-h1" style="max-width:1100px;margin:28px auto 12px;padding:0 16px;font-size:2rem;line-height:1.2;font-weight:700;color:#0f172a">Text Generator pricing</h1>
    {% include "templates/shared/subscribe.jinja2" %}
{% endblock %}


