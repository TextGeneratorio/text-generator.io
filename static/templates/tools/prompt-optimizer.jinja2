{% set default_prompt = 'Create a launch campaign for a new sparkling water brand.' %}
{% set default_evolve = 'Make it specific, actionable, and clear about the audience, tone, and deliverables.' %}
{% set default_judge = 'The prompt should produce useful, original campaign ideas with concrete deliverables and a consistent brand voice.' %}

<link rel="stylesheet" href="/static/css/prompt-optimizer.css?v=1">

<main class="prompt-opt-page">
    <div class="prompt-opt-wrap">
        <nav class="prompt-opt-crumbs" aria-label="Breadcrumb">
            <a href="/">Text Generator</a><span>/</span><a href="/tools">Tools</a><span>/</span><span>Prompt optimizer</span>
        </nav>

        {% if subscription_required %}
        <section class="prompt-opt-access">
            <span class="material-icons" aria-hidden="true">auto_fix_high</span>
            <p class="prompt-opt-kicker">Prompt optimizer</p>
            <h1>Turn a rough idea into a prompt you can use.</h1>
            <p>{{ subscription_message }}</p>
            <div class="prompt-opt-access-actions">
                <a class="prompt-opt-button prompt-opt-button--primary" href="/subscribe">Unlock prompt optimizer</a>
                <a class="prompt-opt-button prompt-opt-button--secondary" href="/login?next=%2Ftools%2Fprompt-optimizer">Log in</a>
            </div>
        </section>
        {% else %}
        <header class="prompt-opt-hero">
            <div>
                <p class="prompt-opt-kicker">Prompt optimizer</p>
                <h1>Start rough.<br><em>Finish ready.</em></h1>
            </div>
            <p>Describe what you want, what should improve, and what a great result looks like. We’ll sharpen the prompt and show the changes.</p>
        </header>

        <div class="prompt-opt-layout">
            <form id="prompt-opt-form" class="prompt-opt-form">
                <div class="prompt-opt-field prompt-opt-field--main">
                    <div class="prompt-opt-label-row">
                        <label for="initial-prompt">Your prompt</label>
                        <span>What do you want the AI to do?</span>
                    </div>
                    <textarea id="initial-prompt" rows="7" maxlength="12000" required>{{ default_prompt }}</textarea>
                </div>

                <div class="prompt-opt-field">
                    <div class="prompt-opt-label-row">
                        <label for="evolve-prompt">What should improve?</label>
                        <span>Focus the rewrite</span>
                    </div>
                    <textarea id="evolve-prompt" rows="4" maxlength="4000" required>{{ default_evolve }}</textarea>
                </div>

                <div class="prompt-opt-field">
                    <div class="prompt-opt-label-row">
                        <label for="judge-prompt">What does “good” look like?</label>
                        <span>Set the goal</span>
                    </div>
                    <textarea id="judge-prompt" rows="4" maxlength="4000" required>{{ default_judge }}</textarea>
                </div>

                <button id="optimize-btn" class="prompt-opt-button prompt-opt-button--primary prompt-opt-submit" type="submit">
                    <span class="material-icons" aria-hidden="true">auto_fix_high</span>
                    <span data-button-label>Improve my prompt</span>
                </button>
                <p id="prompt-opt-status" class="prompt-opt-status" role="status" aria-live="polite"></p>
            </form>

            <section id="prompt-opt-result" class="prompt-opt-result" hidden aria-live="polite">
                <div class="prompt-opt-result-head">
                    <div><p class="prompt-opt-kicker">Improved prompt</p><h2>Ready to copy</h2></div>
                    <button id="copy-final-prompt" class="prompt-opt-copy" type="button"><span class="material-icons" aria-hidden="true">content_copy</span> Copy</button>
                </div>
                <div id="final-prompt" class="prompt-opt-final"></div>
                <details class="prompt-opt-details">
                    <summary>See how it improved</summary>
                    <ol id="prompt-opt-history"></ol>
                </details>
            </section>

            <aside id="prompt-opt-empty" class="prompt-opt-empty">
                <span class="material-icons" aria-hidden="true">tips_and_updates</span>
                <h2>A stronger prompt is a few details away.</h2>
                <p>Your original intent stays intact. The optimizer adds clarity, useful constraints, and a better definition of success.</p>
                <ul>
                    <li><span>1</span> Add the task</li>
                    <li><span>2</span> Guide the rewrite</li>
                    <li><span>3</span> Define success</li>
                </ul>
            </aside>
        </div>
        {% endif %}
    </div>
</main>

{% if not subscription_required %}
<script src="/static/js/prompt-optimizer.js?v=2" defer></script>
{% endif %}
