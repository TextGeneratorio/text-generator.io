<link rel="stylesheet" href="/static/css/domain-generator.css?v=1">

<main class="domain-search-page">
    <div class="domain-search-wrap">
        <nav class="domain-crumbs" aria-label="Breadcrumb">
            <a href="/">Text Generator</a><span>/</span><a href="/tools">Tools</a><span>/</span><span>Domain search</span>
        </nav>

        {% if subscription_required %}
        <section class="domain-access-card">
            <span class="material-icons" aria-hidden="true">travel_explore</span>
            <p class="domain-eyebrow">AI domain explorer</p>
            <h1>Turn one naming idea into a whole search trail.</h1>
            <p>{{ subscription_message }}</p>
            <div class="domain-access-actions">
                <a class="domain-button domain-button--primary" href="/subscribe">Unlock domain search</a>
                <a class="domain-button domain-button--secondary" href="/login?next=%2Ftools%2Fdomain-generator">Log in</a>
            </div>
        </section>
        {% else %}
        <section class="domain-search-hero">
            <div class="domain-search-intro">
                <p class="domain-eyebrow"><span></span> Domain search</p>
                <h1>Find the name.<br><em>Follow the thread.</em></h1>
                <p class="domain-search-lead">Generate a first batch, save the strongest ideas, then explore sharper variations without losing your work.</p>
                <div class="domain-search-proof" aria-label="Search features">
                    <span><i class="material-icons" aria-hidden="true">verified</i> Availability checked</span>
                    <span><i class="material-icons" aria-hidden="true">account_tree</i> Explore variations</span>
                    <span><i class="material-icons" aria-hidden="true">bookmark</i> Save favorites</span>
                </div>
            </div>

            <form id="domain-search-form" class="domain-search-form" data-endpoint="/api/tools/domain-generator/search">
                <label for="domain-brief">What are you naming?</label>
                <textarea id="domain-brief" name="description" rows="5" maxlength="3000" required>{{ domain_default_prompt }}</textarea>

                <div class="domain-form-row">
                    <div class="domain-field">
                        <label for="domain-ideas">Starting ideas <span>one per line</span></label>
                        <textarea id="domain-ideas" name="current_ideas" rows="3">{{ domain_default_ideas }}</textarea>
                    </div>
                    <div class="domain-field domain-field--compact">
                        <label for="domain-batch-size">Names per search</label>
                        <select id="domain-batch-size" name="batch_size">
                            <option value="12">12 · quick</option>
                            <option value="18" selected>18 · balanced</option>
                            <option value="24">24 · wide</option>
                        </select>
                    </div>
                </div>

                <button id="domain-search-submit" class="domain-button domain-button--primary domain-search-submit" type="submit">
                    <span class="material-icons" aria-hidden="true">auto_awesome</span>
                    <span>Explore domains</span>
                    <i class="material-icons" aria-hidden="true">arrow_forward</i>
                </button>
                <p class="domain-form-note">We check likely availability. Confirm with a registrar before you buy.</p>
            </form>
        </section>

        <section id="domain-workspace" class="domain-workspace" aria-live="polite">
            <div class="domain-results-panel">
                <header class="domain-results-header">
                    <div>
                        <p class="domain-eyebrow">Results</p>
                        <h2 id="domain-results-title">Your next domain is a branch away.</h2>
                    </div>
                    <div id="domain-wave-badge" class="domain-wave-badge" hidden>Round <span>1</span></div>
                </header>

                <div id="domain-empty-state" class="domain-empty-state">
                    <div class="domain-orbit" aria-hidden="true"><span></span><i></i><b></b></div>
                    <h3>Try the example brief</h3>
                    <p>We’ll check your starting ideas, create new directions, and keep everything together.</p>
                    <button class="domain-text-button" type="button" data-start-search>Run the example search <span aria-hidden="true">→</span></button>
                </div>

                <div id="domain-results-content" hidden>
                    <div class="domain-toolbar">
                        <div class="domain-filter-group" role="group" aria-label="Filter domains">
                            <button class="is-active" type="button" data-filter="all">All <span id="domain-count-all">0</span></button>
                            <button type="button" data-filter="available">Available <span id="domain-count-available">0</span></button>
                            <button type="button" data-filter="shortlisted">Shortlist <span id="domain-count-shortlisted">0</span></button>
                        </div>
                        <button id="domain-copy-available" class="domain-icon-button" type="button" title="Copy available domains">
                            <span class="material-icons" aria-hidden="true">content_copy</span><span>Copy available</span>
                        </button>
                    </div>
                    <div id="domain-loading" class="domain-loading" hidden>
                        <span></span><span></span><span></span>
                        <p>Finding names and checking availability…</p>
                    </div>
                    <div id="domain-error" class="domain-error" role="alert" hidden></div>
                    <div id="domain-results-grid" class="domain-results-grid"></div>
                    <div id="domain-no-filter-results" class="domain-no-filter-results" hidden>No domains match this filter yet.</div>
                    <button id="domain-explore-more" class="domain-button domain-button--more" type="button" hidden>
                        <span class="material-icons" aria-hidden="true">add_circle</span>
                        Find more names
                    </button>
                </div>
            </div>

            <aside class="domain-shortlist-panel">
                <header>
                    <span class="material-icons" aria-hidden="true">bookmark</span>
                    <div><p class="domain-eyebrow">Your picks</p><h2>Your shortlist</h2></div>
                </header>
                <div id="domain-shortlist-empty" class="domain-shortlist-empty">
                    <p>Save promising names as you explore. They’ll stay here between visits.</p>
                </div>
                <ol id="domain-shortlist"></ol>
                <button id="domain-download-shortlist" class="domain-button domain-button--secondary" type="button" disabled>
                    <span class="material-icons" aria-hidden="true">download</span> Export shortlist
                </button>
            </aside>
        </section>
        {% endif %}
    </div>
</main>

{% if not subscription_required %}
<script src="/static/js/domain-generator.js?v=2" defer></script>
{% endif %}
