<section class="tts-studio" data-textgen-api="{{ inference_server_url }}">
    <div class="tts-studio__shell">
        <nav class="tts-breadcrumbs"><a href="/tools">Tools</a><i class="material-icons">chevron_right</i><span>Text to Speech</span></nav>

        <header class="tts-studio__hero">
            <div>
                <span class="tts-eyebrow"><i></i> First-party voice studio</span>
                <h1>Give your words<br><span>a real voice.</span></h1>
                <p>Write with instant on-device typeahead, audition distinct voices, and generate production-ready speech. App.nz routes bill your Text Generator credit balance.</p>
                <div class="tts-hero-meta"><span><i class="material-icons">bolt</i>Local autocomplete</span><span><i class="material-icons">lock</i>Drafts stay in your browser</span><span><i class="material-icons">graphic_eq</i>Four speech routes</span></div>
            </div>
            <aside class="tts-route-card">
                <div class="tts-route-card__top"><span><i></i> Route ready</span><small>OpenAI compatible</small></div>
                <div class="tts-route-card__line"><img src="/static/img/text-generator-brain.png" alt=""><div><small>Default route</small><strong>Kokoro · af_nicole</strong></div><i class="material-icons">arrow_forward</i></div>
                <code>POST /api/v1/generate_speech</code>
            </aside>
        </header>

        <main class="tts-studio__workspace">
            <section class="tts-compose" aria-label="Speech composer">
                <div class="tts-section-heading"><div><span>01</span><div><strong>Write the script</strong><small>Autocomplete runs against a local frequency index.</small></div></div><button id="tts-example" type="button">Use example</button></div>
                <div class="tts-editor">
                    <textarea id="tts-text" rows="7" maxlength="5000" autocomplete="off" spellcheck="true" aria-autocomplete="list" aria-controls="tts-typeahead" aria-expanded="false">Welcome to Text Generator. One API gives your application a fast, natural voice.</textarea>
                    <div class="tts-typeahead" id="tts-typeahead" role="listbox" hidden></div>
                    <footer><span><i class="material-icons">auto_awesome</i> Local typeahead</span><span id="tts-character-count">82 / 5000</span></footer>
                </div>

                <div class="tts-section-heading tts-section-heading--route"><div><span>02</span><div><strong>Choose a route</strong><small>Switch models without rebuilding the request.</small></div></div><div class="tts-credit-chip"><span>Balance <strong id="tts-credit-balance">$0.00</strong></span><button id="tts-topup" type="button">Top up</button></div></div>
                <div class="tts-model-grid" id="tts-model-grid">
                    <label><input type="radio" name="tts-model" value="kokoro" checked><span><b>Text Generator</b><strong>Kokoro</strong><small>Fast English speech</small></span></label>
                    <label><input type="radio" name="tts-model" value="supertonic"><span><b>Text Generator</b><strong>Supertonic</strong><small>Multilingual speech</small></span></label>
                    <label><input type="radio" name="tts-model" value="appnz-tts"><span><b>App.nz</b><strong>App.nz TTS</strong><small>$0.10 / min · TG credits</small></span></label>
                    <label><input type="radio" name="tts-model" value="pocket-tts"><span><b>App.nz</b><strong>Pocket TTS</strong><small>$0.06 / min · TG credits</small></span></label>
                </div>

                <div class="tts-controls">
                    <label><span>Voice</span><select id="tts-voice"></select></label>
                    <label><span>Language</span><select id="tts-language">
                        <option value="en">English</option><option value="es">Spanish</option><option value="fr">French</option><option value="de">German</option><option value="it">Italian</option><option value="pt">Portuguese</option><option value="ja">Japanese</option><option value="ko">Korean</option><option value="hi">Hindi</option><option value="ar">Arabic</option>
                    </select></label>
                    <label><span>Speed <output id="tts-speed-value">1.0×</output></span><input id="tts-speed" type="range" min="0.6" max="1.6" step="0.1" value="1"></label>
                </div>

                <button class="tts-generate" id="tts-generate" type="button"><span class="tts-generate__icon"><i class="material-icons">play_arrow</i></span><span><strong>Generate speech</strong><small id="tts-generate-route">Text Generator · Kokoro</small></span><i class="material-icons">arrow_forward</i></button>
                <p class="tts-status" id="tts-status" aria-live="polite">Sign in to generate with your Text Generator account.</p>
            </section>

            <aside class="tts-output" aria-label="Speech result">
                <div class="tts-output__chrome"><span><i></i><i></i><i></i></span><strong>Voice preview</strong><small id="tts-route-status">Ready</small></div>
                <div class="tts-voice-orb" id="tts-voice-orb"><span><i class="material-icons">graphic_eq</i></span><div class="tts-wave" aria-hidden="true">{% for i in range(24) %}<i style="--i:{{ i }}"></i>{% endfor %}</div></div>
                <div class="tts-now-playing"><small>Selected voice</small><strong id="tts-now-voice">af_nicole</strong><span id="tts-now-model">Kokoro · Text Generator</span></div>
                <audio id="tts-audio" controls preload="none"></audio>
                <div class="tts-output__facts"><span><small>Format</small><strong id="tts-format">WAV</strong></span><span><small>Processing</small><strong id="tts-processing">Local draft</strong></span><span><small>Billing</small><strong id="tts-billing">Account usage</strong></span></div>
            </aside>
        </main>

        <section class="tts-api-panel">
            <div><span class="tts-eyebrow tts-eyebrow--dark"><i></i> Copy-ready API</span><h2>The same voice, in your app.</h2><p>The code updates with the selected route. All routes bill Text Generator credits at $0.01 each; App.nz speech is proxied and metered through your account.</p></div>
            <div class="tts-code-card">
                <div class="tts-code-tabs" role="tablist"><button class="is-active" data-tts-code="curl" type="button">cURL</button><button data-tts-code="javascript" type="button">JavaScript</button><button data-tts-code="python" type="button">Python</button><span id="tts-code-provider">Text Generator</span></div>
                <pre><code id="tts-code"></code></pre>
            </div>
        </section>
    </div>
</section>
