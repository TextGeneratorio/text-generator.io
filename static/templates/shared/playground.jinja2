<style>
.tg-toggle-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    user-select: none;
}
.tg-toggle-input {
    display: none;
}
.tg-toggle-switch {
    width: 36px;
    height: 20px;
    background: #ccc;
    border-radius: 10px;
    position: relative;
    transition: background 0.2s;
    flex-shrink: 0;
}
.tg-toggle-switch::after {
    content: '';
    width: 16px;
    height: 16px;
    background: #fff;
    border-radius: 50%;
    position: absolute;
    top: 2px;
    left: 2px;
    transition: transform 0.2s;
}
.tg-toggle-input:checked + .tg-toggle-switch {
    background: #f17d34;
}
.tg-toggle-input:checked + .tg-toggle-switch::after {
    transform: translateX(16px);
}
.tg-toggle-text {
    font-size: 13px;
    color: #333;
}
/* Code example dialog */
#code-example-dialog {
    width: min(900px, calc(100vw - 32px));
    max-width: none;
    max-height: min(760px, calc(100dvh - 32px));
    padding: 0;
    overflow: hidden;
    border: 1px solid #dce3eb;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 24px 70px rgba(12, 32, 52, 0.28);
}
#code-example-dialog::backdrop {
    background: rgba(8, 21, 39, 0.68);
    backdrop-filter: blur(3px);
}
#code-example-dialog .code-dialog__header {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    min-height: 72px;
    padding: 14px 64px 14px 18px;
    border-bottom: 1px solid #e4e9ef;
}
#code-example-dialog .code-dialog__title {
    flex: 1 0 100%;
    margin: 0;
    color: #17324d;
    font-size: 16px;
    font-weight: 700;
}
#code-example-dialog .code-dialog__controls {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
}
#code-example-dialog .code-dialog__language {
    width: 150px;
    margin-left: auto;
    padding: 0;
}
#code-example-dialog .code-dialog__language label {
    display: block;
    margin-bottom: 3px;
    color: #6f8294;
    font-size: 11px;
    line-height: 1;
}
#code-example-dialog .code-dialog__language select {
    height: 30px;
    padding: 0 4px;
}
#code-example-dialog .code-dialog__close {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: #63788c;
    cursor: pointer;
    font: 400 28px/1 Arial, sans-serif;
}
#code-example-dialog .code-dialog__close:hover {
    background: #eef3f7;
    color: #17324d;
}
#code-example-dialog .code-dialog__close:focus-visible {
    outline: 3px solid rgba(241, 125, 52, 0.35);
    outline-offset: 1px;
}
#code-example-dialog .mdl-dialog__content {
    max-height: calc(min(760px, 100dvh - 32px) - 72px);
    overflow: auto;
    padding: 14px 16px 16px !important;
}
#code-example-dialog .mdl-dialog__content pre {
    margin: 0;
}
#code-example-dialog .mdl-dialog__content > div {
    position: relative;
}
#code-example-dialog .mdl-dialog__content pre code {
    width: 100%;
    box-sizing: border-box;
}
#code-example-dialog .mdl-dialog__content pre {
    position: relative;
}
#code-example-dialog .mdl-dialog__content pre code {
    display: block;
    padding: 12px 12px 12px 48px !important;
    font-size: 13px;
    line-height: 1.5;
    border-radius: 6px;
    background: #1e1e2e !important;
    color: #cdd6f4 !important;
    overflow-x: auto;
    counter-reset: line;
}
#code-example-dialog .mdl-dialog__content pre code .hljs-line {
    display: block;
    counter-increment: line;
}
#code-example-dialog .mdl-dialog__content pre code .hljs-line::before {
    content: counter(line);
    display: inline-block;
    width: 28px;
    margin-left: -40px;
    margin-right: 12px;
    text-align: right;
    color: #585b70;
    font-size: 12px;
    user-select: none;
    -webkit-user-select: none;
}
/* Catppuccin Mocha-inspired syntax colors */
#code-example-dialog pre code .hljs-keyword { color: #cba6f7 !important; }
#code-example-dialog pre code .hljs-string { color: #a6e3a1 !important; }
#code-example-dialog pre code .hljs-title,
#code-example-dialog pre code .hljs-function .hljs-title { color: #89b4fa !important; }
#code-example-dialog pre code .hljs-built_in { color: #f9e2af !important; }
#code-example-dialog pre code .hljs-comment { color: #6c7086 !important; font-style: italic; }
#code-example-dialog pre code .hljs-number { color: #fab387 !important; }
#code-example-dialog pre code .hljs-attr,
#code-example-dialog pre code .hljs-attribute { color: #89dceb !important; }
#code-example-dialog pre code .hljs-params { color: #f2cdcd !important; }
#code-example-dialog pre code .hljs-literal { color: #fab387 !important; }
.code-copy-btn {
    position: absolute;
    top: 12px;
    right: 12px;
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.18);
    color: #cdd6f4;
    padding: 4px 10px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 12px;
    z-index: 10;
    transition: background 0.15s;
}
.code-copy-btn:hover {
    background: rgba(255,255,255,0.25);
}
.code-copy-btn.copied {
    background: rgba(166,227,161,0.3);
    color: #a6e3a1;
}
/* compact playground layout */
.demo-ribbon { height: 18vh; }
.demo-main { margin-top: -16vh; }
.playground-content { margin-bottom: 24px; padding: 16px 20px; }
.pg-preset-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 6px;
    flex-wrap: wrap;
}
.pg-preset-row .select2 { max-width: 100%; }
#playground-form .mdl-textfield { padding: 6px 0; }
.playground-textarea { resize: vertical; }
.pg-media-row {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin: 8px 0 10px;
}
#playground-media-dropzone {
    flex: 1 1 220px;
    border: 1px dashed #b7b7c9;
    border-radius: 8px;
    padding: 7px 12px;
    color: #777;
    background: #faf8f5;
    font-size: 12.5px;
}
#playground-media { position: absolute; width: 1px; height: 1px; opacity: 0; overflow: hidden; clip: rect(0 0 0 0); }
.pg-media-picker {
    display: inline-flex; align-items: center; gap: 7px; cursor: pointer;
    padding: 9px 14px; border-radius: 8px; border: 1px solid #d79f2a;
    color: #6f4215; background: linear-gradient(135deg, #fff8e8, #fff1d0);
    font-size: 13px; font-weight: 600; transition: box-shadow .15s, transform .15s;
}
.pg-media-picker:hover { box-shadow: 0 3px 10px rgba(126, 78, 20, .2); transform: translateY(-1px); }
.pg-media-picker:focus-within, #playground-media:focus + .pg-media-picker { outline: 3px solid rgba(59, 130, 246, .35); outline-offset: 2px; }
.pg-media-picker .material-icons { font-size: 18px; }

.pg-actions { display: flex; align-items: center; gap: 12px; margin-top: 4px; }
.pg-actions .mdl-button { margin: 0; }
.pg-settings .pg-controls {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 22px;
    row-gap: 4px;
    align-items: start;
}
.pg-control { min-width: 0; }
.pg-control--wide { grid-column: 1 / -1; }
.pg-settings .playground-label {
    margin: 4px 0 0;
    font-size: 13px;
    font-weight: 600;
    color: #555;
}
.pg-settings .mdl-slider__container { height: 22px; }
.pg-settings input.mdl-slider { padding: 0; margin: 0; }
.pg-settings select.playground-textarea,
.pg-settings textarea.playground-textarea {
    font-size: 13px;
    padding: 5px 8px;
    border-radius: 6px;
}
.pg-settings #system-message { margin-bottom: 2px; }
.pg-settings .tg-toggle-label { margin-top: 4px; }
@media (max-width: 839px) {
    .demo-ribbon { height: 10vh; }
    .demo-main { margin-top: -9vh; }
    .playground-content { padding: 12px; margin-bottom: 12px; }
    .demo-container.mdl-grid { padding: 4px; }
    .demo-container .mdl-cell { margin: 4px; width: calc(100% - 8px); }
    #playground-text { min-height: 30vh; }
    .playground-tooltip { min-width: 0 !important; max-width: calc(100vw - 32px) !important; }
    #code-example-dialog {
        width: calc(100vw - 16px);
        max-height: calc(100dvh - 16px);
        border-radius: 14px;
    }
    #code-example-dialog .code-dialog__header {
        align-items: stretch;
        min-height: 0;
        padding: 14px 56px 12px 12px;
    }
    #code-example-dialog .code-dialog__controls {
        align-items: stretch;
        flex-wrap: wrap;
    }
    #code-example-dialog .code-dialog__controls .mdl-chip {
        flex: 1 1 auto;
        justify-content: flex-start;
        margin: 0;
    }
    #code-example-dialog .code-dialog__language {
        flex: 1 0 100%;
        width: 100%;
        margin: 2px 0 0;
    }
    #code-example-dialog .code-dialog__close {
        top: 8px;
        right: 8px;
        width: 44px;
        height: 44px;
    }
    #code-example-dialog .mdl-dialog__content {
        max-height: calc(100dvh - 170px);
        padding: 10px 8px 8px !important;
    }
    #code-example-dialog .mdl-dialog__content pre code {
        padding: 12px 42px 12px 40px !important;
        font-size: 12px;
    }
    .pg-settings .pg-controls { column-gap: 14px; }
}
@media (max-width: 420px) {
    .pg-settings .pg-controls { grid-template-columns: 1fr; }
}
</style>
<script src="/static/libs/highlight.pack.js"></script>
