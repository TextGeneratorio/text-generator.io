{% extends 'templates/base.jinja2' %}

{% block headers %}


    <meta charset="utf-8">
    <title>{{ title }}</title>
    <meta name="description"
          content="{{ description }}">

    <link rel="canonical" href="https://text-generator.io{{ request.url.path }}">
    <meta property="article:published_time" content="2026-10-22">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="keywords" content="{{ keywords }}">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:url" content="{{ url }}">
    <meta property="og:image" content="https://text-generator.io/static/img/og-card.jpg">
    <meta property="og:description"
          content="{{ description }}">
    <meta property="og:type" content="article">
    <meta property="og:site_name" content="Text Generator">
    <meta property="fb:admins" content="337972272904903">

{% endblock %}

{% block mainbody %}
    {% include blogtemplate %}
{% endblock %}


