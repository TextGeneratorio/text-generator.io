{% extends 'templates/base.jinja2' %}

{% set snippet = (share.output.split() | join(' '))[:155] %}
{% set seo_image = "https://text-generator.io/s/" ~ share.id ~ "/og.jpg" %}
{% set share_title = share.tool_name %}

{% block headers %}
    <title>{{ share.tool_name }} result - made with Text Generator</title>
    <meta name="description" content="{{ snippet }}">
    <meta name="robots" content="noindex, follow">
    <meta property="og:title" content="{{ share.tool_name }} result - made with Text Generator">
    <meta property="og:description" content="{{ snippet }}">
    <meta property="og:url" content="https://text-generator.io/s/{{ share.id }}">
    <meta property="og:image" content="{{ seo_image }}">
    <meta property="og:type" content="article">
    <meta property="og:site_name" content="Text Generator">
{% endblock %}

{% block mainbody %}
<main class="tg-shared">
    <p class="tg-shared__eyebrow">Shared result &middot; <a href="/tools/{{ share.tool }}">{{ share.tool_name }}</a> &middot; {{ share.views }} view{{ '' if share.views == 1 else 's' }}</p>
    <h1>{{ share.tool_name }} result</h1>
    {% if share.input %}
    <section class="tg-shared__block">
        <h2>Input</h2>
        <div class="tg-shared__text">{{ share.input }}</div>
    </section>
    {% endif %}
    <section class="tg-shared__block tg-shared__block--out">
        <h2>Result</h2>
        <div class="tg-shared__text">{{ share.output }}</div>
    </section>
    <section class="tg-shared__cta">
        <div>
            <strong>Make your own with {{ share.tool_name }}</strong>
            <span>{{ share.tool_description }}</span>
        </div>
        <a class="tg-shared__btn" href="/tools/{{ share.tool }}?ref=share">Try {{ share.tool_name }} free</a>
    </section>
    <p class="tg-shared__made">Made with <a href="/?ref=share">Text Generator</a>, one OpenAI-compatible API for the best AI models. <a href="/tools">Browse all free tools</a>.</p>
    <nav class="tg-shared__sibs" aria-label="More from our network">
        <span>More from our network:</span>
        <a href="https://netwrck.com/?ref=text-generator" rel="noopener">Netwrck AI characters</a>
        <a href="https://aiart-generator.art/?ref=text-generator" rel="noopener">AI Art Generator</a>
        <a href="https://codex-infinity.com/?ref=text-generator" rel="noopener">Codex Infinity</a>
        <a href="https://openpaths.io/?ref=text-generator" rel="noopener">OpenPaths</a>
        <a href="https://app.nz/?ref=text-generator" rel="noopener">App.nz</a>
    </nav>
</main>
{% include 'templates/shared/share_bar.jinja2' %}
<style>
.tg-shared{max-width:860px;margin:32px auto 0;padding:0 16px;box-sizing:border-box;color:#0f172a}
.tg-shared__eyebrow{margin:0 0 8px;color:#475569;font-size:14px}
.tg-shared__eyebrow a{color:#1c4774!important;display:inline!important}
.tg-shared h1{font-size:2rem;line-height:1.2;margin:0 0 20px}
.tg-shared h2{font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:#475569;margin:0 0 8px}
.tg-shared__block{border:1px solid #d7dee8;border-radius:14px;padding:18px 20px;margin:0 0 16px;background:#fff}
.tg-shared__block--out{background:#f7f9fc}
.tg-shared__text{white-space:pre-wrap;word-break:break-word;font-size:16px;line-height:1.6}
.tg-shared__cta{display:flex;flex-wrap:wrap;gap:16px;align-items:center;justify-content:space-between;padding:22px;border-radius:16px;background:#0f2440;color:#fff;margin-top:24px}
.tg-shared__cta div{display:flex;flex-direction:column;gap:4px;min-width:0;flex:1 1 260px}
.tg-shared__cta span{color:#c5d2e6;font-size:14px}
.tg-shared__btn{display:inline-flex!important;align-items:center;min-height:48px;padding:0 24px;border-radius:999px;background:#ff9a62;color:#0f172a!important;font-weight:700;text-decoration:none}
.tg-shared__made{margin:20px 0 8px;color:#334155;font-size:15px}
.tg-shared__made a,.tg-shared__sibs a{color:#1c4774!important;display:inline!important;font-weight:600}
.tg-shared__sibs{display:flex;flex-wrap:wrap;gap:6px 14px;font-size:14px;color:#475569}
</style>
{% endblock %}
