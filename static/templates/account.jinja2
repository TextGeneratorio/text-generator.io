{% extends 'templates/base.jinja2' %}

{% block headers %}

    {% set title = 'Your Account - Text Generator API Key and Credits' -%}
    {% set description = 'Manage your Text Generator account: copy your API key, make your first API call, and top up credits.' -%}
    <meta name="robots" content="noindex">

    <meta charset="utf-8">
    <title>{{ title }}</title>
    <meta name="description"
          content="{{ description }}">

    <meta name="keywords" content="ai bot, text generator, OpenAI, GPT">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:url" content="{{ url }}">
    <meta property="og:image" content="https://text-generator.io/static/img/og-card.jpg">
    <meta property="og:description"
          content="{{ description }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Text Generator">
    <meta property="fb:admins" content="337972272904903">

{% endblock %}

{% block mainbody %}
    <script>
        function displayDates() {
            $.each($('.moment-date'), function (idx, el) {
                var dateUnix = $(el).html()
                var momenttime = moment.unix(dateUnix);
                var dateText = momenttime.fromNow()
                $(el).html(dateText);
                $(el).attr('title', momenttime.format('MMMM Do YYYY, h:mm:ss a'))
            });
        }

        initApp = function () {
            // Check PostgreSQL authentication
            checkAuthStatus();
        }

        async function checkAuthStatus() {
            try {
                console.log('checkAuthStatus: checking authentication...');
                const response = await fetch('/api/current-user');
                console.log('checkAuthStatus: current-user response:', response.status, response.statusText);
                
                if (response.ok) {
                    const user = await response.json();
                    console.log('checkAuthStatus: user authenticated:', user);
                    // User is signed in
                    window.user = user;
                    
                    // Get user data with Stripe usage
                    getUserWithStripe(user, function (data) {
                        console.log('checkAuthStatus: got user data with stripe:', data);
                        var email = data['email'];
                        $('.email').html(email);

                        var api_key = data['secret'];
                        $('.api_key').html(api_key);
                        var creditBalanceCents = data['credit_balance_cents'] || 0;
                        $('.credit_balance').html(`$${(creditBalanceCents / 100).toFixed(2)} (${creditBalanceCents} credits @ $0.01)`);

                        {#var referral_url_key = data['referral_url_key'];#}
                        {#$('.referral_url_key').html('https://bitbank.nz?r=' + referral_url_key)#}
                        $('#manage-subscriptions-link').html(`<a href="/portal" target="_blank" class="mdl-button mdl-js-button">Manage Subscriptions</a>`)
                        $('#buy-credits-link').html(`<button class="mdl-button mdl-js-button mdl-button--raised mdl-button--accent" onclick="if(window.showCheckoutDialog){ showCheckoutDialog('credits'); }">Buy API Credits</button>`)
                        fetch('/api/credits/balance').then(function (r) { return r.ok ? r.json() : null; }).then(function (credits) {
                            if (!credits || !credits.autotopup) return;
                            var a = credits.autotopup;
                            $('#autotopup-enabled').prop('checked', !!a.enabled);
                            $('#autotopup-threshold').val(a.threshold || 100);
                            $('#autotopup-amount').val(a.amount || 500);
                            $('#autotopup-card').text(a.hasCard ? 'Card on file' : 'Buy credits once to save a card');
                            $('#autotopup-panel').show();
                        });
                        // No usage tracking anymore - we don't do metering

                        $('#self-hosting').html("<h4>Download Self Hosted Server</h4> <h5>Direct Docker Image Download</h5><p> <a href='https://storage.googleapis.com/questions-346919/text-generator.tar'>Docker Container .tar Download</a></p>" +
                          "<h5>Container download script</h5><p> <pre><code>curl https://static.text-generator.io/static/resources/download_container.sh | bash</code></pre></p>" +
                          "<p>After downloading the container with either method, proceed to follow the <a href='/self-hosting'>self host instructions</a> available for <a href='/docs/kubernetes'>Kubernetes</a>, <a href='/docs/docker'>Docker</a></p>" );

                    });
                } else {
                    // User is signed out - let's see what the error is
                    const errorText = await response.text();
                    console.log('checkAuthStatus: authentication failed:', response.status, errorText);
                    console.error('Authentication failed:', response.status, '-', errorText);
                    // Don't redirect automatically for now
                }
            } catch (error) {
                console.log('checkAuthStatus: error:', error);
                console.error('Error checking authentication:', error.message);
                // Don't redirect automatically for now
            }
        };

        // Removed plotPlotlyGraph function - no longer needed since we don't do metering

        window.addEventListener('load', function () {
            initApp()
        });
    </script>
    <div class="demo-ribbon"></div>
    <main class="demo-main mdl-layout__content">
        <div class="demo-container mdl-grid">
            <div class="mdl-cell mdl-cell--2-col mdl-cell--hide-tablet mdl-cell--hide-phone"></div>
            <div class="demo-content mdl-color--white mdl-shadow--4dp content mdl-color-text--grey-800 mdl-cell mdl-cell--8-col">

                <h3>Account Info</h3>
                {#                <p>Your unique bitcoin address for payment:</p>#}
                {#                <code><p class="btc-address"></p></code>#}

                <p>Email: <span class="email"></span></p>


                {#                <p>Your referral url: <span class="referral_url_key"></span></p>#}
                <p>Your API key: <code><span class="api_key"></span></code></p>
                <div class="tg-quickstart" style="margin:18px 0;padding:16px;border:1px solid #d7dee8;border-radius:10px;background:#f7f9fc;">
                    <h4 style="margin:0 0 6px;">Make your first API call</h4>
                    <p style="margin:0 0 10px;color:#475569;">Paste this in a terminal. It already includes your key.</p>
                    <pre style="margin:0;padding:12px;overflow-x:auto;background:#0f172a;color:#e2e8f0;border-radius:8px;font-size:13px;line-height:1.5;"><code id="tg-quickstart-curl">curl https://api.text-generator.io/v1/chat/completions \
  -H "Authorization: Bearer <span class="api_key">YOUR_API_KEY</span>" \
  -H "Content-Type: application/json" \
  -d '{"model": "text-generator/auto", "messages": [{"role": "user", "content": "Write a haiku about APIs"}]}'</code></pre>
                    <p style="margin:10px 0 0;display:flex;flex-wrap:wrap;gap:8px;align-items:center;">
                        <button class="mdl-button mdl-js-button mdl-button--raised mdl-button--colored" type="button" id="tg-quickstart-copy">Copy curl command</button>
                        <a class="mdl-button mdl-js-button" href="/playground">Try it in the playground</a>
                        <a class="mdl-button mdl-js-button" href="/docs">API docs</a>
                    </p>
                    <script>
                        document.getElementById('tg-quickstart-copy').addEventListener('click', function () {
                            var btn = this, text = document.getElementById('tg-quickstart-curl').textContent;
                            var done = function () { btn.textContent = 'Copied'; setTimeout(function () { btn.textContent = 'Copy curl command'; }, 1600); };
                            if (navigator.clipboard) { navigator.clipboard.writeText(text).then(done, function () { window.prompt('Copy:', text); }); } else { window.prompt('Copy:', text); }
                        });
                    </script>
                </div>
                <p>Your credit balance: <strong><span class="credit_balance"></span></strong></p>

                <h4>Settings</h4>
                <p id="manage-subscriptions-link"></p>
                <p id="buy-credits-link"></p>
                <div id="autotopup-panel" style="display:none;margin:16px 0;padding:14px;border:1px solid #e5e7eb;border-radius:8px;">
                    <h5 style="margin:0 0 8px;">Auto-topup</h5>
                    <p style="margin:0 0 10px;color:#666;font-size:0.9rem;">When balance dips below the threshold, charge your saved card for more $0.01 credits.</p>
                    <p id="autotopup-card" style="margin:0 0 10px;font-size:0.85rem;"></p>
                    <label style="display:block;margin-bottom:8px;"><input type="checkbox" id="autotopup-enabled"> Enable auto-topup</label>
                    <label style="display:inline-block;margin-right:12px;">Threshold <input id="autotopup-threshold" type="number" min="0" step="1" value="100" style="width:90px;"></label>
                    <label style="display:inline-block;margin-right:12px;">Amount <input id="autotopup-amount" type="number" min="100" step="1" value="500" style="width:90px;"></label>
                    <button class="mdl-button mdl-js-button mdl-button--raised" id="autotopup-save" type="button">Save</button>
                    <p id="autotopup-status" style="margin:8px 0 0;font-size:0.85rem;"></p>
                </div>
                <script>
                    document.getElementById('autotopup-save').addEventListener('click', async function () {
                        var status = document.getElementById('autotopup-status');
                        status.textContent = 'Saving…';
                        try {
                            var response = await fetch('/api/credits/autotopup', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                    enabled: document.getElementById('autotopup-enabled').checked,
                                    threshold: Number(document.getElementById('autotopup-threshold').value || 0),
                                    amount: Number(document.getElementById('autotopup-amount').value || 0)
                                })
                            });
                            var data = await response.json().catch(function () { return {}; });
                            if (!response.ok) throw new Error(data.detail || 'Could not save auto-topup');
                            status.textContent = data.autotopup && data.autotopup.enabled ? 'Auto-topup enabled.' : 'Auto-topup paused.';
                        } catch (error) {
                            status.textContent = error.message;
                        }
                    });
                </script>
                <h4>Self Hosting</h4>
                <div id="self-hosting"></div>

                <button class="mdl-button mdl-js-button mdl-button--raised" onclick="signout()">Log out</button>
                <script>
                    function signout() {
                        fetch('/api/logout', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                            },
                        }).then(() => {
                            clearUserDataFromStorage();
                            location.href = '/login';
                        }).catch(error => {
                            console.error('Error signing out:', error);
                            clearUserDataFromStorage();
                            location.href = '/login';
                        });
                    }
                </script>
            </div>
        </div>

    </main>


    <div id="cancel-section" style="display:none;margin:24px auto;max-width:720px;text-align:center;">
        <button id="cancel-open" class="mdl-button mdl-js-button">Cancel subscription</button>
    </div>
    <dialog id="cancel-modal" style="max-width:480px;width:92%;border:0;border-radius:12px;padding:24px;">
        <div id="cancel-offer-phase" style="display:none;">
            <h3 style="margin-top:0;" id="cancel-offer-title"></h3>
            <p id="cancel-offer-body"></p>
            <p id="cancel-offer-error" style="color:#b91c1c;display:none;"></p>
            <button id="cancel-offer-accept" class="mdl-button mdl-js-button mdl-button--raised mdl-button--accent"></button>
            <button id="cancel-offer-decline" class="mdl-button mdl-js-button">No thanks, continue</button>
        </div>
        <div id="cancel-survey-phase" style="display:none;">
            <h3 style="margin-top:0;">Why are you leaving?</h3>
            <select id="cancel-reason" style="width:100%;padding:10px;margin-bottom:12px;">
                <option value="">Select a reason</option>
                <option value="too_expensive">Too expensive</option>
                <option value="not_using">Not using it enough</option>
                <option value="missing_features">Missing features</option>
                <option value="quality">Output quality</option>
                <option value="switched_provider">Switched to another provider</option>
                <option value="technical_issues">Technical issues</option>
                <option value="temporary">Only needed it temporarily</option>
                <option value="other">Other</option>
            </select>
            <textarea id="cancel-details" maxlength="2000" placeholder="Anything we should know?" style="width:100%;min-height:80px;padding:10px;"></textarea>
            <p id="cancel-error" style="color:#b91c1c;display:none;"></p>
            <button id="cancel-confirm" class="mdl-button mdl-js-button mdl-button--raised" disabled>Cancel at end of billing period</button>
            <button class="mdl-button mdl-js-button cancel-close">Keep my subscription</button>
        </div>
        <div id="cancel-done-phase" style="display:none;">
            <h3 style="margin-top:0;" id="cancel-done-title"></h3>
            <p id="cancel-done-body"></p>
            <button class="mdl-button mdl-js-button cancel-close">Close</button>
        </div>
    </dialog>
    <script>
    (function () {
        var modal = document.getElementById('cancel-modal');
        var offer = null, offerShown = null;
        function show(id) {
            ['cancel-offer-phase', 'cancel-survey-phase', 'cancel-done-phase'].forEach(function (p) {
                document.getElementById(p).style.display = p === id ? 'block' : 'none';
            });
        }
        function post(url, body) {
            return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body || {}) })
                .then(function (r) { return r.json().catch(function () { return {}; }).then(function (d) { return { ok: r.ok, data: d }; }); });
        }
        function done(title, body) {
            document.getElementById('cancel-done-title').textContent = title;
            document.getElementById('cancel-done-body').textContent = body;
            show('cancel-done-phase');
        }
        function survey() { show('cancel-survey-phase'); }
        fetch('/api/cancel/offer').then(function (r) { return r.ok ? r.json() : null; }).then(function (o) {
            if (!o || o.reason === 'no_active_subscription' || o.reason === 'already_canceling') return;
            offer = o;
            document.getElementById('cancel-section').style.display = 'block';
        }).catch(function () {});
        document.getElementById('cancel-open').addEventListener('click', function () {
            var accept = document.getElementById('cancel-offer-accept');
            if (offer && offer.offer === 'coupon') {
                offerShown = 'coupon';
                document.getElementById('cancel-offer-title').textContent = 'Stay for 50% off';
                document.getElementById('cancel-offer-body').textContent = 'Keep your subscription at half price for the next 3 months. One time offer.';
                accept.textContent = 'Apply 50% off';
                show('cancel-offer-phase');
            } else if (offer && offer.offer === 'downgrade') {
                offerShown = 'downgrade';
                document.getElementById('cancel-offer-title').textContent = 'Switch to Lite instead';
                document.getElementById('cancel-offer-body').textContent = 'Based on your API usage, Lite ($' + (offer.lite_price_cents / 100).toFixed(0) + '/month) fits better. Usage beyond its allowance draws from your prepaid credits.';
                accept.textContent = 'Switch to Lite';
                show('cancel-offer-phase');
            } else {
                survey();
            }
            modal.showModal();
        });
        document.getElementById('cancel-offer-accept').addEventListener('click', function () {
            var url = offerShown === 'downgrade' ? '/api/downgrade-plan' : '/api/apply-retention-coupon';
            post(url).then(function (res) {
                if (res.ok) {
                    done('Done', offerShown === 'downgrade' ? 'You are now on Lite.' : '50% off applied for 3 months.');
                    document.getElementById('cancel-section').style.display = 'none';
                } else {
                    var err = document.getElementById('cancel-offer-error');
                    err.textContent = 'Could not apply the offer. You can continue to cancel below.';
                    err.style.display = 'block';
                }
            });
        });
        document.getElementById('cancel-offer-decline').addEventListener('click', survey);
        document.getElementById('cancel-reason').addEventListener('change', function () {
            document.getElementById('cancel-confirm').disabled = !this.value;
        });
        document.getElementById('cancel-confirm').addEventListener('click', function () {
            var btn = this;
            btn.disabled = true;
            post('/api/cancel-subscription', {
                reason: document.getElementById('cancel-reason').value,
                details: document.getElementById('cancel-details').value,
                offer_shown: offerShown
            }).then(function (res) {
                if (res.ok) {
                    done('Subscription cancelled', 'You keep access until the end of your billing period. Your API key and any prepaid credits are unaffected.');
                    document.getElementById('cancel-section').style.display = 'none';
                } else {
                    var err = document.getElementById('cancel-error');
                    err.textContent = 'Could not cancel. Please try again or contact support.';
                    err.style.display = 'block';
                    btn.disabled = false;
                }
            });
        });
        Array.prototype.forEach.call(document.querySelectorAll('.cancel-close'), function (b) {
            b.addEventListener('click', function () { modal.close(); });
        });
    })();
    </script>

{% endblock %}

